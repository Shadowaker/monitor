# 42
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://monitor.42roma.it/callback
OAUTH_AUTHORIZE_URL=https://api.intra.42.fr/oauth/authorize
OAUTH_TOKEN_URL=https://api.intra.42.fr/oauth/token
OAUTH_API_BASE_URL=https://api.intra.42.fr

# Flask
FLASK_SECRET_KEY=replace_me_with_secure_secret
FLASK_HOST=monitor.42roma.it
FLASK_PORT=443
FLASK_DEBUG=false

# 42 Roma - SSL
SSL_CERT_PATH=/etc/ssl/42roma.it.crt
SSL_KEY_PATH=/etc/ssl/wildcard.key

# 42 Roma - Siti interni:
CAMPUS_URL=
NAGIOS_URL=

# 42 Roma, various
AUTHORIZED_USERS=ffrau
CAMPUS_ID=30
CURSUS_ID=21
EVENT_LOOKAHEAD_DAYS=7

# Banner data
BANNER_DEFAULT_VISIBLE=false
BANNER_DEFAULT_TEXT="🔔 Attenzione: Manutenzione programmata il 10 maggio"

# Common Core (/statistics/cc)
# true = tornando indietro da pagina successiva, parte dall'ultimo cerchio
# false = tornando indietro, parte dal primo cerchio (default)
CC_BACK_NAV_START_FROM_END=false

# Events
EVENT_SUMMARIZE_URL=
EVENT_SUMMARIZE_TIMEOUT=90
EVENT_SUMMARIZE_MAX_WORKERS=4

# Data
TOTAL_WORKSTATIONS=150
STUDENT_ORIGIN_COUNTRY="Italy"
STUDENT_ORIGIN_OTHERS_LABEL="Altri"

#   Funnel
FUNNEL_DISPLAY_TEST_ONLINE=9000
FUNNEL_DISPLAY_PISCINE=2100
FUNNEL_DISPLAY_COMMON_CORE=830
FUNNEL_DISPLAY_ADVANCED_CORE=190

FUNNEL_CHART_TEST_ONLINE=9000
FUNNEL_CHART_PISCINE=4800
FUNNEL_CHART_COMMON_CORE=2000
FUNNEL_CHART_ADVANCED_CORE=850

# Map
WORLD_MAP_SIDEBAR_ENABLED=true
WORLD_MAP_SIDEBAR_VERTICAL=true
# Paese evidenziato sulla mappa (nome o codice ISO, es. Italy, Luxembourg, LU).
# Lascia vuoto per disattivare. WORLD_MAP_ITALY_NEON_ENABLED=true equivale a Italy.
# WORLD_MAP_HIGHLIGHT_COUNTRY=France #<--- Decommenta se vuoi cambiare paese
WORLD_MAP_ITALY_NEON_ENABLED=true #<--- Commenta se vuoi cambiare paese

# CC
CC_SHOW_MASTERY=true
CC_MASTERY_VISIBLE=true
CC_SIDEBAR_RIGHT=false
CC_GRADE_FOOTNOTE_MARK_NEON=true
CC_GRADE_FOOTNOTE_BELOW=false
CC_STATS_INTRO_NEON=true
CC_STATS_INTRO_BELOW=false
CC_BACK_NAV_START_FROM_END=true
NETWORK_SCHOOLS_URL=https://www.42network.org/42-schools/
NETWORK_SCHOOLS_USER_AGENT=""
NETWORK_SCHOOLS_TIMEOUT=30
NETWORK_SCHOOLS_CACHE_HOURS=24

# Log
LOG_MAX_BYTES = 10485760
LOG_BACKUP_COUNT=5